{
  "name": "makemyqrcode.com",
  "version": "1.0.0",
  "private": true,
  "description": "Static site. Only used to rebuild css/tailwind.css.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
